@@ -0,0 +1,118 @@
+//! (Runline trace patch) Scenarios faith-runner's own tests don't cover, recorded only so
+//! RunlineCore's replays can check them: the jump buffer (jump pressed in the air just before
+//! touchdown) and the walk-off coyote jump (jump pressed just after running off a ledge). They
+//! assert nothing; the trace is the point. Never committed to faith-runner.
+use crate::*;
+use glam::{Vec2, Vec3};
+
+const DT: f32 = 1.0 / 60.0;
+
+fn floor() -> BoxWorld {
+    let mut w = BoxWorld::default();
+    w.add(Aabb::new(Vec3::new(-50.0, -1.0, -50.0), Vec3::new(50.0, 0.0, 50.0)));
+    w
+}
+
+/// Dropping 1.5 m onto a floor, jump pressed `k` frames into the fall (touchdown is around frame
+/// 25; the buffer is 0.15 s, 9 frames).
+fn buffer(k: usize) {
+    let w = floor();
+    let mut c = Controller::new(Tuning::default(), Vec3::new(0.0, 1.5, 0.0), 0.0);
+    for f in 0..60 {
+        let i = Input { jump_pressed: f == k, jump_held: f >= k && f < k + 10, ..Default::default() };
+        c.step(DT, &i, &w);
+    }
+}
+
+#[test]
+fn buffer_k15() { buffer(15) }
+#[test]
+fn buffer_k16() { buffer(16) }
+#[test]
+fn buffer_k17() { buffer(17) }
+#[test]
+fn buffer_k18() { buffer(18) }
+#[test]
+fn buffer_k20() { buffer(20) }
+
+/// Running off a 1 m ledge (facing +x), jump pressed `n` frames after she's left it (coyote time
+/// is 0.12 s, about 7 frames).
+fn coyote(n: usize) {
+    let mut w = floor();
+    w.add(Aabb::new(Vec3::new(-10.0, 0.0, -5.0), Vec3::new(0.0, 1.0, 5.0)));
+    let mut c = Controller::new(Tuning::default(), Vec3::new(-2.0, 1.0, 0.0), -std::f32::consts::FRAC_PI_2);
+    c.state = State::Ground;
+    let mut off: Option<usize> = None;
+    for f in 0..120 {
+        if off.is_none() && c.state == State::Air {
+            off = Some(f);
+        }
+        let press = off.is_some_and(|o| f == o + n);
+        let i = Input { move_axis: Vec2::new(0.0, 1.0), jump_pressed: press, jump_held: press, ..Default::default() };
+        c.step(DT, &i, &w);
+    }
+}
+
+#[test]
+fn coyote_n03() { coyote(3) }
+#[test]
+fn coyote_n06() { coyote(6) }
+#[test]
+fn coyote_n07() { coyote(7) }
+#[test]
+fn coyote_n09() { coyote(9) }
+
+/// A floor and a long wall, too tall to climb to the top of, whose face is at z = -2 (facing +z).
+fn wall_world() -> BoxWorld {
+    let mut w = floor();
+    w.add(Aabb::new(Vec3::new(-30.0, 0.0, -3.0), Vec3::new(30.0, 10.0, -2.0)));
+    w
+}
+
+/// Running at the wall `deg` degrees off parallel and jumping just before it: FindWallForward
+/// only takes a wall you face at most WallRunningForwardMaxStartAngle (57 degrees) into.
+fn wall_approach(deg: f32) {
+    let w = wall_world();
+    let a = deg.to_radians();
+    let fwd = Vec3::new(a.cos(), 0.0, -a.sin());
+    let yaw = (-fwd.x).atan2(-fwd.z);
+    let start = Vec3::new(0.0, 0.0, -1.7) - fwd * 8.0;
+    let mut c = Controller::new(Tuning::default(), start, yaw);
+    c.state = State::Ground;
+    let mut jumped = false;
+    for _ in 0..150 {
+        let near = c.feet.z < -1.7 + 0.9;
+        let press = near && !jumped;
+        jumped |= press;
+        let i = Input { move_axis: Vec2::new(0.0, 1.0), jump_pressed: press, jump_held: press, ..Default::default() };
+        c.step(DT, &i, &w);
+    }
+}
+
+#[test]
+fn wall_approach_50() { wall_approach(50.0) }
+#[test]
+fn wall_approach_56() { wall_approach(56.0) }
+#[test]
+fn wall_approach_58() { wall_approach(58.0) }
+#[test]
+fn wall_approach_65() { wall_approach(65.0) }
+
+/// Wallclimbing, turning round with Q, then not kicking: after the kick window she drops off.
+#[test]
+fn wallclimb_turn_no_kick() {
+    let w = wall_world();
+    let mut c = Controller::new(Tuning::default(), Vec3::new(0.0, 0.0, 4.0), 0.0);
+    c.state = State::Ground;
+    let mut jumped = false;
+    let mut turned = false;
+    for _ in 0..150 {
+        let press = c.feet.z < -1.7 + 0.9 && !jumped;
+        jumped |= press;
+        let turn = matches!(c.state, State::WallClimb { .. }) && !turned;
+        turned |= turn;
+        let fwd = if turned { 0.0 } else { 1.0 };
+        let i = Input { move_axis: Vec2::new(0.0, fwd), jump_pressed: press, jump_held: press, turn_pressed: turn, ..Default::default() };
+        c.step(DT, &i, &w);
+    }
+}
