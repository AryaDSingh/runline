+//! (Runline trace patch) Records every Controller::step a test makes, for RunlineCore's replay
+//! tests. Only active when FAITH_TRACE_DIR is set. Never committed to faith-runner.
+use crate::controller::{Controller, Input};
+use crate::tuning::Tuning;
+use crate::world::World;
+use std::cell::RefCell;
+use std::io::Write as _;
+
+thread_local! {
+    /// Controllers seen on this test thread (numbered from 1): the world each last wrote, and its
+    /// state after its last step (to spot a test changing it between steps).
+    static SEEN: RefCell<Vec<(String, String)>> = RefCell::new(Vec::new());
+}
+
+fn dir() -> Option<String> {
+    std::env::var("FAITH_TRACE_DIR").ok()
+}
+
+fn append(id: usize, text: &str) {
+    let name = std::thread::current().name().unwrap_or("main").replace("::", "__");
+    let path = format!("{}/{}__{}.trace", dir().unwrap(), name, id);
+    let mut f = std::fs::OpenOptions::new().create(true).append(true).open(path).unwrap();
+    f.write_all(text.as_bytes()).unwrap();
+}
+
+fn b(x: bool) -> u8 {
+    x as u8
+}
+
+fn snapshot(c: &Controller) -> String {
+    format!(
+        "{},{},{},{},{},{},{},{},{},{},{}",
+        c.feet.x, c.feet.y, c.feet.z, c.vel.x, c.vel.y, c.vel.z, c.yaw, c.pitch, c.state.name(), b(c.crouched), c.sprint_charge
+    )
+}
+
+pub fn before(c: &mut Controller, dt: f32, i: &Input, w: &dyn World) {
+    if dir().is_none() {
+        return;
+    }
+    let mut text = String::new();
+    if c.trace_id == 0 {
+        c.trace_id = SEEN.with(|s| {
+            let mut s = s.borrow_mut();
+            s.push((String::new(), String::new()));
+            s.len()
+        });
+        let default = format!("{:?}", c.tuning) == format!("{:?}", Tuning::default());
+        text += &format!(
+            "trace,3\ntuning_default,{}\nspawn,{},{},{},{}\ninit,{}\nstate_debug,{:?}\n",
+            b(default), c.spawn.x, c.spawn.y, c.spawn.z, c.spawn_yaw, snapshot(c), c.state
+        );
+    } else {
+        // A test changed the controller since its last step: record what it set.
+        let now = snapshot(c);
+        let last = SEEN.with(|s| s.borrow()[c.trace_id - 1].1.clone());
+        if now != last {
+            text += &format!("set,{}\n", now);
+        }
+    }
+    let dump = w.dump();
+    let changed = SEEN.with(|s| {
+        let mut s = s.borrow_mut();
+        let last = &mut s[c.trace_id - 1].0;
+        if *last != dump || text.starts_with("trace,") {
+            *last = dump.clone();
+            true
+        } else {
+            false
+        }
+    });
+    if changed {
+        text += &format!("world\n{}end_world\n", dump);
+    }
+    text += &format!(
+        "in,{},{},{},{},{},{},{},{},{},{},{},{},{}\n",
+        dt, i.move_axis.x, i.move_axis.y, i.look.x, i.look.y,
+        b(i.jump_pressed), b(i.jump_held), b(i.crouch_pressed), b(i.crouch_held),
+        b(i.turn_pressed), b(i.melee_pressed), b(i.takedown_pressed), i.strafe_raw
+    );
+    append(c.trace_id, &text);
+}
+
+/// The host-facing outputs: the eye, the mesh offset, the hands on a wall, and the payloads of
+/// Land and the dodges (the out record only names events).
+fn ext(c: &Controller) -> String {
+    use crate::controller::Event;
+    let v = c.view();
+    let hand = |h: Option<glam::Vec3>| match h {
+        Some(p) => format!("1,{},{},{}", p.x, p.y, p.z),
+        None => "0,,,".to_string(),
+    };
+    let payloads: Vec<String> = c
+        .events
+        .iter()
+        .filter_map(|e| match e {
+            Event::Land { impact, fall } => Some(format!("Land:{}:{}", impact, fall)),
+            Event::Dodge { dir } => Some(format!("Dodge:{}:{}:{}", dir.x, dir.y, dir.z)),
+            Event::WallRunDodge { dir } => Some(format!("WallRunDodge:{}:{}:{}", dir.x, dir.y, dir.z)),
+            Event::WallClimbDodge { dir } => Some(format!("WallClimbDodge:{}:{}:{}", dir.x, dir.y, dir.z)),
+            _ => None,
+        })
+        .collect();
+    format!(
+        "ext,{},{},{},{},{},{},{}\n",
+        v.eye.x, v.eye.y, v.eye.z, c.mesh_offset, hand(c.against_wall.left), hand(c.against_wall.right), payloads.join(";")
+    )
+}
+
+pub fn after(c: &Controller) {
+    if dir().is_none() || c.trace_id == 0 {
+        return;
+    }
+    let events: Vec<String> = c
+        .events
+        .iter()
+        .map(|e| format!("{:?}", e).split(|ch: char| !ch.is_alphanumeric() && ch != '_').next().unwrap_or("").to_string())
+        .collect();
+    let now = snapshot(c);
+    SEEN.with(|s| s.borrow_mut()[c.trace_id - 1].1 = now.clone());
+    append(c.trace_id, &format!("out,{},{}\n{}", now, events.join(";"), ext(c)));
+}
